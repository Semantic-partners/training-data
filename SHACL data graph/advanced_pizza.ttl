prefix ex: <http://example.org/>
prefix pizza: <http://www.co-ode.org/ontologies/pizza/pizza.owl#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix sh: <http://www.w3.org/ns/shacl#>


ex:PepperoniPizza a pizza:SpicyPizza ;
  pizza:hasTopping ex:TomatoSauce, ex:Mozzarella, ex:Pepperoni, ex:Onions ;
  pizza:hasBase ex:Thin .
ex:Pepperoni a pizza:Topping ;
  pizza:hasSpiciness pizza:Hot ;
  pizza:calories 50 .
ex:Onions a pizza:Topping ;
  pizza:hasSpiciness pizza:Mild ;
  pizza:calories 40 .
