# Cookbook recipe — people.csv → RDF with RML (executed by rmlmapper).
#
# This is the turtle that people.yarrrml.yml compiles to. RML is a W3C-community
# standard: declarative, tool-independent, multi-source. Run with:
#   java -jar $RMLMAPPER -m mappings/people.rml.ttl -s turtle -o build/people-rml.ttl
#
# THE PAIN (on show, deliberately): RML templates percent-encode, and core RML
# has no string functions — so {birth_town} for "New York" yields
# .../place/New%20York, NOT .../place/New_York like the other recipes. `make
# cookbook` will flag that as a difference. Closing it needs an FNML/FnO function
# (grel:string_replace) — verbose machinery for one replace. That's the trade:
# declarative portability vs inline expressiveness.

@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix family: <http://family.org/> .
@prefix bio:    <http://example.org/bio/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix :       <http://example.org/rules/> .

:people a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/people.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "http://example.org/person/{id}" ;
        rr:class family:Person
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate bio:birthYear ;
        rr:objectMap [ rml:reference "birth_year" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate bio:wasBornIn ;
        rr:objectMap [ rr:template "http://example.org/place/{birth_town}" ; rr:termType rr:IRI ]
    ] .
