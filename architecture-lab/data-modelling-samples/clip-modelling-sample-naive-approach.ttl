@prefix media: <http://media.org/> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:interview_1 a media:Video .

ex:time_1 a media:PeriodOfTime .

ex:time_2 a media:PeriodOfTime .

ex:clip_1 a media:Video ;
    media:isCreatedBy ex:team_1 ;
    media:isExtractedFrom ex:interview_1 ;
    media:isCreatedWith ex:editor_1 ;
    media:isCreatedAtTime ex:time_1 ;
    media:isDeletedBy ex:team_1 ;
    media:isDeletedWith ex:editor_1 ;
    media:isDeletedAtTime ex:time_2 .


